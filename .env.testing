APP_NAME=Wisata
APP_ENV=testing
APP_KEY=base64:TEST_KEY_FOR_TESTING_ONLY
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

LOG_CHANNEL=stack

# Use SQLite in-memory database for fast testing
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Or use MySQL test database
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=wisata_test
# DB_USERNAME=root
# DB_PASSWORD=

CACHE_DRIVER=array
QUEUE_CONNECTION=sync

JWT_SECRET=TEST_JWT_SECRET_FOR_TESTING_ONLY
JWT_ALGO=HS256
